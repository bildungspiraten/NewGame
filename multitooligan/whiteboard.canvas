    { "id": "r-kontext", "type": "text", "text": "**📎 Fehlende Kontexte**\n\n• Was habe ich weggelassen: ___\n• Was war der eigentliche Hintergrund: ___\n• Was hat das beeinflusst: ___", "x": 600, "y": -190, "width": 300, "height": 140, "color": "2" },

    { "id": "r-beduerfnis", "type": "text", "text": "**💛 Zurückgestellte Bedürfnisse**\n\n• Bedürfnis 1: ___\n• Bedürfnis 2: ___\n\n(Benennen – nicht bewerten)", "x": 920, "y": -190, "width": 280, "height": 140, "color": "2" }

